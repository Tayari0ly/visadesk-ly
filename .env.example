# PostgreSQL / Neon pooled connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Required in production; generate a long random value
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional first-run bootstrap; remove after the first admin is created
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-10-characters

# Optional local-only Ollama endpoint; leave empty in cloud deployments
OLLAMA_BASE_URL=http://127.0.0.1:11434

NEXT_PUBLIC_APP_NAME=VisaDesk LY
