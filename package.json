{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "import:madrid-hotels": "npx tsx scripts/import-madrid-hotels.ts",
    "download:regional-hotels": "bash scripts/download-regional-hotel-sources.sh",
    "import:castilla-y-leon-hotels": "npx tsx scripts/import-regional-hotels.ts --region castilla-y-leon --file data/sources/castilla-y-leon-alojamientos_hoteleros.csv",
    "import:valencia-hotels": "npx tsx scripts/import-regional-hotels.ts --region valencia --file data/sources/valencia-hoteles.csv",
    "import:catalonia-hotels": "npx tsx scripts/import-regional-hotels.ts --region catalonia --file data/sources/catalonia-accommodation.csv"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.46.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "tsx": "^4.21.0"
  }
}
